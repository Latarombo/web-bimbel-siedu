# --- Database (Supabase Postgres, session pooler port 5432) ---
DATABASE_URL="postgresql://postgres.<project-ref>:***@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Auth (Auth.js v5, JWT) ---
AUTH_SECRET="isi-dengan-openssl-rand-base64-32"
# AUTH_URL="https://siedu.vercel.app" # wajib saat deploy Vercel
# --- Google OAuth (opsional; isi keduanya untuk mengaktifkan tombol Google) ---
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
CRON_SECRET="isi-dengan-openssl-rand-hex-32"

# --- Midtrans SNAP (opsional; kosong = halaman pay fallback transfer manual) ---
# Dashboard: https://app.sandbox.midtrans.com (sandbox) / https://app.midtrans.com (production)
# MIDTRANS_ENV=sandbox|production (default sandbox)
# Webhook URL di dashboard Midtrans: https://<host>/api/webhooks/midtrans
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""

# --- Google Maps Embed API (opsional; kosong = peta halaman Kontak pakai OpenStreetMap) ---
# Cloud Console: project > APIs & Services > Library > "Maps Embed API" > Enable
# Credentials > Create API key > App restrictions: HTTP referrers:
#   http://localhost:3000/* dan https://<domain-produksi>/*
# Key Embed API bersifat publik (muncul di src iframe), dibatasi referrer.
NEXT_PUBLIC_GMAPS_EMBED_KEY=""

# Key gratis utk basemap CARTO (Leaflet di halaman /contact). Tanpa key -> fallback iframe OpenStreetMap.
# Minta via https://carto.com/basemaps/apikey/ (email + domain, tanpa akun). Fair use 5 juta tile/bulan.
NEXT_PUBLIC_CARTO_BASEMAPS_KEY=""
