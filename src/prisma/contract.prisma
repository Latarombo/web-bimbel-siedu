// use prisma-next
// Siedu — Prisma Next contract (Postgres)
// Stack: Next.js + @prisma/orm-postgres + PostgreSQL (Supabase)
// Revisi skema 5 Sep 2026 — BR#27-31 (lihat ATURAN_SISTEM.md Bagian 3)
enum Role {
  admin
  guru
  orang_tua

  @@map("role")
}

enum Jenjang {
  TK
  SD
  SMP
  SMA
}

enum Hari {
  Senin
  Selasa
  Rabu
  Kamis
  Jumat
  Sabtu
  Minggu
}

enum StatusKelas {
  aktif
  dibatalkan
}

enum StatusPeriode {
  dibuka
  ditutup
  selesai
}

enum MetodeBayar {
  lunas
  dp_cicilan
}

enum StatusPendaftaran {
  menunggu_pembayaran
  terdaftar
  tertunggak
  dibatalkan_timeout
  dibatalkan_tunggakan
  dibatalkan_orang_tua
  dibatalkan_kelas
}

enum TipePembayaran {
  dp
  cicilan
  lunas
}

enum StatusPembayaran {
  pending
  berhasil
  gagal
}

enum StatusPresensi {
  hadir
  izin
  sakit
  alpa
}

enum StatusPengajuan {
  menunggu
  disetujui
  ditolak
}

enum KategoriRefund {
  kesalahan_sistem
  salah_nominal_transfer
  salah_rekening
  salah_pilih_kelas
  lainnya
}

model User {
  id                 Int                @id @default(autoincrement())
  role               Role
  name               String
  email              String             @unique
  alamat             String?
  nomorTelepon       String             @unique @map("nomor_telepon")
  emailVerifiedAt    TimestamptzString? @map("email_verified_at")
  password           String
  googleSub          String?            @unique @map("google_sub")
  privasiDisetujuiAt TimestamptzString? @map("privasi_disetujui_at")
  waliDisetujuiAt    TimestamptzString? @map("wali_disetujui_at")
  createdAt          TimestamptzString  @default(now()) @map("created_at")
  updatedAt          TimestamptzString  @default(now()) @map("updated_at")

  anak               Anak[]                @relation("OrangTuaAnak")
  kelasDiampu        Kelas[]               @relation("GuruKelas")
  presensiDicatat    Presensi[]            @relation("GuruPresensi")
  nilaiDiinput       NilaiProgres[]        @relation("GuruNilai")
  catatanPertemuan   CatatanPertemuan[]    @relation("GuruCatatanPertemuan")
  auditAktor         AuditPerubahan[]      @relation("AktorAudit")
  koreksiDiajukan    PengajuanKoreksi[]    @relation("GuruPengajuanKoreksi")
  koreksiDiproses    PengajuanKoreksi[]    @relation("AdminPengajuanKoreksi")
  penilaianDibuat    Penilaian[]           @relation("GuruPenilaian")
  laporanPerkembangan LaporanPerkembangan[] @relation("GuruLaporanPerkembangan")
  statusDibuat       StatusPembelajaran[]  @relation("GuruStatusPembelajaran")
  laporanFoto        LaporanFotoStatus[]   @relation("PelaporFotoStatus")
  pengajuanDiajukan  PengajuanPembatalan[] @relation("PengajuPembatalan")
  pengajuanDiproses  PengajuanPembatalan[] @relation("AdminPembatalan")

  @@index(expression: "lower(email)", unique: true, name: "users_email_lower")
  @@map("users")
}

model Anak {
  id              Int               @id @default(autoincrement())
  orangTuaId      Int               @map("orang_tua_id")
  nama            String
  tanggalLahir    DateString        @map("tanggal_lahir")
  jenjangTerakhir Jenjang?          @map("jenjang_terakhir")
  tingkat         String?           @map("tingkat")
  emailNotifikasi String?           @map("email_notifikasi")
  nomorTelepon    String?           @map("nomor_telepon")
  createdAt       TimestamptzString @default(now()) @map("created_at")
  updatedAt       TimestamptzString @default(now()) @map("updated_at")

  orangTua        User                         @relation("OrangTuaAnak", fields: [orangTuaId], references: [id], onDelete: Cascade)
  pendaftaran     Pendaftaran[]
  persetujuanFoto Boolean                      @default(false) @map("persetujuan_foto")
  statusDiterima  StatusPembelajaranPenerima[]

  @@index([orangTuaId])
  // BR#16: deteksi duplikat anak — cari by tanggal_lahir + nama dinormalisasi
  @@index([tanggalLahir])
  @@check(expression: "tanggal_lahir <= CURRENT_DATE", name: "anak_dob_not_future")
  @@map("anak")
}

model MataPelajaran {
  id        Int               @id @default(autoincrement())
  nama      String
  deskripsi String?
  createdAt TimestamptzString @default(now()) @map("created_at")
  updatedAt TimestamptzString @default(now()) @map("updated_at")

  kelas Kelas[]

  @@unique([nama])
  @@map("mata_pelajaran")
}

model PeriodePendaftaran {
  id                      Int               @id @default(autoincrement())
  nama                    String
  tanggalMulai            DateString        @map("tanggal_mulai")
  tanggalSelesai          DateString        @map("tanggal_selesai")
  tanggalTutupPendaftaran DateString        @map("tanggal_tutup_pendaftaran")
  status                  StatusPeriode     @default(dibuka)
  createdAt               TimestamptzString @default(now()) @map("created_at")
  updatedAt               TimestamptzString @default(now()) @map("updated_at")

  kelas       Kelas[]
  pendaftaran Pendaftaran[]

  @@index([status])
  @@check(expression: "tanggal_mulai < tanggal_selesai", name: "periode_range")
  @@check(expression: "tanggal_tutup_pendaftaran <= tanggal_selesai", name: "periode_tutup_dbl_selesai")
  @@map("periode_pendaftaran")
}

model Kelas {
  id              Int               @id @default(autoincrement())
  mataPelajaranId Int               @map("mata_pelajaran_id")
  guruId          Int               @map("guru_id")
  periodeId       Int               @map("periode_id")
  jenjang         Jenjang
  tingkat         String?           @map("tingkat")
  kuotaMaksimum   Int               @map("kuota_maksimum")
  kuotaMinimum    Int               @map("kuota_minimum")
  kuotaTerisi     Int               @default(0) @map("kuota_terisi")
  biayaPeriode    Decimal           @map("biaya_periode")
  biayaDp         Decimal?          @map("biaya_dp")
  tenorMaksimum   Int?              @map("tenor_maksimum")
  status          StatusKelas       @default(aktif)
  createdAt       TimestamptzString @default(now()) @map("created_at")
  updatedAt       TimestamptzString @default(now()) @map("updated_at")

  mataPelajaran MataPelajaran      @relation(fields: [mataPelajaranId], references: [id], onDelete: Restrict)
  guru          User               @relation("GuruKelas", fields: [guruId], references: [id], onDelete: Restrict)
  periode       PeriodePendaftaran @relation(fields: [periodeId], references: [id], onDelete: Restrict)
  jadwalItem         JadwalItem[]
  pendaftaran        Pendaftaran[]
  statusPembelajaran StatusPembelajaran[]

  @@index([guruId])
  @@index([periodeId, status])
  @@index([mataPelajaranId])
  @@index([jenjang])
  @@index([tingkat])
  @@check(expression: "kuota_minimum <= kuota_maksimum", name: "kelas_kuota_range")
  @@check(expression: "kuota_terisi <= kuota_maksimum", name: "kelas_kuota_terisi")
  @@check(expression: "biaya_periode > 0", name: "kelas_biaya_pos")
  @@check(expression: "biaya_dp IS NULL OR (biaya_dp > 0 AND biaya_dp < biaya_periode)", name: "kelas_dp_range")
  @@check(expression: "tenor_maksimum IS NULL OR tenor_maksimum >= 2", name: "kelas_tenor_min")
  // BR#12: tenor cuma masuk akal untuk kelas yang menawarkan DP
  @@check(expression: "(biaya_dp IS NULL) = (tenor_maksimum IS NULL)", name: "kelas_tenor_butuh_dp")
  @@map("kelas")
}

// BR#27: jadwal 1:N — satu kelas bisa 1-3x pertemuan per minggu
model JadwalItem {
  id         Int      @id @default(autoincrement())
  kelasId    Int      @map("kelas_id")
  hari       Hari
  jamMulai   TimeString @map("jam_mulai")
  jamSelesai TimeString @map("jam_selesai")

  kelas    Kelas      @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  presensi Presensi[]

  @@unique([kelasId, hari, jamMulai, jamSelesai])
  @@index([hari])
  @@check(expression: "jam_mulai < jam_selesai", name: "jadwal_item_jam_range")
  @@map("jadwal_item")
}

model Pendaftaran {
  id                Int                  @id @default(autoincrement())
  anakId            Int                  @map("anak_id")
  kelasId           Int                  @map("kelas_id")
  periodeId         Int                  @map("periode_id")
  jenjangSaatDaftar Jenjang              @map("jenjang_saat_daftar")
  metodeBayar       MetodeBayar          @map("metode_bayar")
  tenorBulan        Int?                 @map("tenor_bulan")
  status            StatusPendaftaran    @default(menunggu_pembayaran)
  createdAt         TimestamptzString    @default(now()) @map("created_at")
  updatedAt         TimestamptzString    @default(now()) @map("updated_at")

  anak                Anak                  @relation(fields: [anakId], references: [id], onDelete: Restrict)
  kelas               Kelas                 @relation(fields: [kelasId], references: [id], onDelete: Restrict)
  periode             PeriodePendaftaran    @relation(fields: [periodeId], references: [id], onDelete: Restrict)
  pembayaran          Pembayaran[]
  presensi            Presensi[]
  nilaiProgres        NilaiProgres[]
  pengajuanPembatalan PengajuanPembatalan[]
  hasilPenilaian      HasilPenilaian[]
  laporanPerkembangan LaporanPerkembangan[]
  statusDiterima      StatusPembelajaranPenerima[]

  @@index([anakId])
  @@index([kelasId])
  @@index([periodeId])
  // Cron BR#2: cuma baris menunggu_pembayaran yang discan tiap 5 menit
  @@index([createdAt], where: "(status = 'menunggu_pembayaran')", name: "pendaftaran_cron_timeout")
  // BR#29: partial unique — anak boleh daftar ulang hanya kalau pendaftaran sebelumnya dibatalkan
  @@index([anakId, kelasId, periodeId], unique: true, where: "(status NOT IN ('dibatalkan_timeout','dibatalkan_tunggakan','dibatalkan_orang_tua','dibatalkan_kelas'))", name: "pendaftaran_aktif_unique")
  // BR#28: dp_cicilan wajib tenor; lunas tidak pakai tenor
  @@check(expression: "(metode_bayar = 'dp_cicilan' AND tenor_bulan IS NOT NULL AND tenor_bulan >= 2) OR (metode_bayar = 'lunas' AND tenor_bulan IS NULL)", name: "pendaftaran_tenor_konsisten")
  @@map("pendaftaran")
}

model Pembayaran {
  id               Int                @id @default(autoincrement())
  pendaftaranId    Int                @map("pendaftaran_id")
  tipe             TipePembayaran
  cicilanKe        Int?               @map("cicilan_ke")
  jumlah           Decimal
  jatuhTempo       DateString?        @map("jatuh_tempo")
  dibayarPada      TimestamptzString? @map("dibayar_pada")
  status           StatusPembayaran   @default(pending)
  referensiGateway String?            @unique @map("referensi_gateway")
  createdAt        TimestamptzString  @default(now()) @map("created_at")
  updatedAt        TimestamptzString  @default(now()) @map("updated_at")

  pendaftaran Pendaftaran @relation(fields: [pendaftaranId], references: [id], onDelete: Restrict)

  @@index([pendaftaranId, status])
  // Cron BR#7: cuma baris pending yang discan tiap 5 menit
  @@index([jatuhTempo], where: "(status = 'pending')", name: "pembayaran_cron_tunggakan")
  @@unique([pendaftaranId, cicilanKe])
  // DP/lunas = cicilan_ke NULL → NULL != NULL di Postgres, guard duplikat di sini
  @@index([pendaftaranId], unique: true, where: "(cicilan_ke IS NULL)", name: "pembayaran_dp_lunas_unik")
  @@check(expression: "jumlah > 0", name: "pembayaran_jumlah_pos")
  @@check(expression: "cicilan_ke IS NULL OR cicilan_ke >= 1", name: "pembayaran_cicilan_ke_pos")
  @@check(expression: "(tipe = 'cicilan') = (cicilan_ke IS NOT NULL)", name: "pembayaran_tipe_cicilan_konsisten")
  @@map("pembayaran")
}

model Presensi {
  id               Int               @id @default(autoincrement())
  pendaftaranId    Int               @map("pendaftaran_id")
  jadwalItemId     Int               @map("jadwal_item_id")
  sesiPertemuanId  Int?              @map("sesi_pertemuan_id")
  terlambat        Boolean           @default(false) @map("terlambat")
  dicatatOleh      Int               @map("dicatat_oleh")
  tanggalPertemuan DateString        @map("tanggal_pertemuan")
  status           StatusPresensi
  catatan          String?
  createdAt        TimestamptzString @default(now()) @map("created_at")
  updatedAt        TimestamptzString @default(now()) @map("updated_at")

  pendaftaran Pendaftaran @relation(fields: [pendaftaranId], references: [id], onDelete: Cascade)
  jadwalItem  JadwalItem @relation(fields: [jadwalItemId], references: [id], onDelete: Restrict)
  sesiPertemuan SesiPertemuan? @relation(fields: [sesiPertemuanId], references: [id], onDelete: SetNull)
  guru        User       @relation("GuruPresensi", fields: [dicatatOleh], references: [id], onDelete: Restrict)

  @@unique([pendaftaranId, tanggalPertemuan, jadwalItemId])
  @@index([dicatatOleh])
  @@index([jadwalItemId])
  @@map("presensi")
}

model NilaiProgres {
  id                Int       @id @default(autoincrement())
  pendaftaranId     Int       @map("pendaftaran_id")
  dicatatOleh       Int       @map("dicatat_oleh")
  tanggal           DateString
  catatanKualitatif String?   @map("catatan_kualitatif")
  nilaiKuantitatif  Decimal?  @map("nilai_kuantitatif")
  createdAt         TimestamptzString @default(now()) @map("created_at")
  updatedAt         TimestamptzString @default(now()) @map("updated_at")

  pendaftaran Pendaftaran @relation(fields: [pendaftaranId], references: [id], onDelete: Cascade)
  guru        User       @relation("GuruNilai", fields: [dicatatOleh], references: [id], onDelete: Restrict)

  @@index([pendaftaranId])
  @@index([dicatatOleh])
  @@check(expression: "nilai_kuantitatif IS NULL OR (nilai_kuantitatif >= 0 AND nilai_kuantitatif <= 100)", name: "nilai_range_0_100")
  @@map("nilai_progres")
}

model PengajuanPembatalan {
  id            Int                @id @default(autoincrement())
  pendaftaranId Int                @map("pendaftaran_id")
  diajukanOleh  Int                @map("diajukan_oleh")
  alasan        String
  kategori      KategoriRefund     @default(lainnya)
  status        StatusPengajuan    @default(menunggu)
  diprosesOleh  Int?               @map("diproses_oleh")
  catatanAdmin  String?            @map("catatan_admin")
  diprosesPada  TimestamptzString? @map("diproses_pada")
  createdAt     TimestamptzString  @default(now()) @map("created_at")
  updatedAt     TimestamptzString  @default(now()) @map("updated_at")

  pendaftaran Pendaftaran @relation(fields: [pendaftaranId], references: [id], onDelete: Cascade)
  pengaju     User       @relation("PengajuPembatalan", fields: [diajukanOleh], references: [id], onDelete: Restrict)
  admin       User?      @relation("AdminPembatalan", fields: [diprosesOleh], references: [id], onDelete: SetNull)

  @@index([diajukanOleh])
  @@index([diprosesOleh])
  @@index([status])
  // Satu pengajuan menunggu per pendaftaran; ditolak → boleh ajukan ulang
  @@index([pendaftaranId], unique: true, where: "(status = 'menunggu')", name: "pengajuan_menunggu_unik")
  @@map("pengajuan_pembatalan")
}


// ---- Portal guru: sesi pertemuan nyata (M1) ----
enum StatusSesi {
  terjadwal
  selesai
  dibatalkan

  @@map("status_sesi")
}

// Pertemuan konkret: dibentuk dari JadwalItem per tanggal dalam periode kelas.
// Snapshot jam saat dibuat supaya edit jadwal rutin tidak merusak histori.
model SesiPertemuan {
  id               Int        @id @default(autoincrement())
  jadwalItemId     Int        @map("jadwal_item_id")
  tanggalPertemuan DateString @map("tanggal_pertemuan")
  statusSesi       StatusSesi @default(terjadwal) @map("status_sesi")
  jamMulai         TimeString @map("jam_mulai")
  jamSelesai       TimeString @map("jam_selesai")
  dibatalkanAlasan String?    @map("dibatalkan_alasan")
  createdAt        TimestamptzString @default(now()) @map("created_at")
  updatedAt        TimestamptzString @default(now()) @map("updated_at")

  jadwalItem JadwalItem @relation(fields: [jadwalItemId], references: [id], onDelete: Restrict)
  presensi   Presensi[]
  peserta    PesertaSesi[]
  catatan    CatatanPertemuan?

  @@unique([jadwalItemId, tanggalPertemuan])
  @@index([tanggalPertemuan])
  @@check(expression: "jam_mulai < jam_selesai", name: "sesi_jam_range")
  @@map("sesi_pertemuan")
}

// Snapshot peserta per sesi: sumber daftar presensi, menggantikan filter
// status pendaftaran saat ini. Diisi saat sesi dibuka/digenerate.
model PesertaSesi {
  id            Int          @id @default(autoincrement())
  sesiId        Int          @map("sesi_id")
  pendaftaranId Int          @map("pendaftaran_id")
  statusDaftar  StatusPendaftaran @map("status_daftar")
  createdAt     TimestamptzString @default(now()) @map("created_at")

  sesi        SesiPertemuan @relation(fields: [sesiId], references: [id], onDelete: Cascade)
  pendaftaran Pendaftaran   @relation(fields: [pendaftaranId], references: [id], onDelete: Cascade)

  @@unique([sesiId, pendaftaranId])
  @@index([pendaftaranId])
  @@map("peserta_sesi")
}

enum StatusPesan {
 baru
 diproses
 selesai

 @@map("status_pesan")
}

// A7 — pesan masuk dari formulir Kontak publik (non-registrasi).
model PesanKontak {
 id Int @id @default(autoincrement())
 nama String
 telepon String
 email String
 sekolah String?
 jenjang Jenjang?
 subjek String
 pesan String
 status StatusPesan @default(baru)
 createdAt TimestamptzString @default(now()) @map("created_at")
 updatedAt TimestamptzString @default(now()) @map("updated_at")

 @@index([status])
 @@index([createdAt])
 @@map("pesan_kontak")
}

// M2 Catatan pertemuan: materi dan PR untuk sesi tertentu.
// Draf server terisolasi dari orang tua sampai diterbitkan oleh guru.
model CatatanPertemuan {
  id              Int               @id @default(autoincrement())
  sesiId          Int               @unique @map("sesi_id")
  materi          String?
  pr              String?
  draf            Boolean           @default(true)
  diterbitkanPada TimestamptzString? @map("diterbitkan_pada")
  dicatatOleh     Int               @map("dicatat_oleh")
  createdAt       TimestamptzString @default(now()) @map("created_at")
  updatedAt       TimestamptzString @default(now()) @map("updated_at")

  sesi SesiPertemuan @relation(fields: [sesiId], references: [id], onDelete: Cascade)
  guru User          @relation("GuruCatatanPertemuan", fields: [dicatatOleh], references: [id], onDelete: Restrict)

  @@index([dicatatOleh])
  @@map("catatan_pertemuan")
}

// M2 Audit perubahan: mencatat setiap koreksi/penarikan/perubahan data.
model AuditPerubahan {
  id        Int               @id @default(autoincrement())
  entitas   String            @map("entitas")
  entitasId Int               @map("entitas_id")
  aksi      String            @map("aksi")
  sebelum   String?           @map("sebelum")
  sesudah   String?           @map("sesudah")
  alasan    String?           @map("alasan")
  aktorId   Int               @map("aktor_id")
  createdAt TimestamptzString @default(now()) @map("created_at")

  aktor User @relation("AktorAudit", fields: [aktorId], references: [id], onDelete: Restrict)

  @@index([entitas, entitasId])
  @@index([aktorId])
  @@map("audit_perubahan")
}

enum StatusPengajuanKoreksi {
  menunggu
  disetujui
  ditolak

  @@map("status_pengajuan_koreksi")
}

// M2 Pengajuan koreksi: diajukan guru saat entri terkunci (> 7 hari), diproses admin.
model PengajuanKoreksi {
  id           Int                    @id @default(autoincrement())
  guruId       Int                    @map("guru_id")
  entitas      String                 @map("entitas")
  entitasId    Int                    @map("entitas_id")
  status       StatusPengajuanKoreksi @default(menunggu)
  dataSebelum  String?                @map("data_sebelum")
  dataUsulan   String                 @map("data_usulan")
  alasan       String                 @map("alasan")
  diprosesOleh Int?                   @map("diproses_oleh")
  catatanAdmin String?                @map("catatan_admin")
  createdAt    TimestamptzString      @default(now()) @map("created_at")
  updatedAt    TimestamptzString      @default(now()) @map("updated_at")

  guru  User  @relation("GuruPengajuanKoreksi", fields: [guruId], references: [id], onDelete: Restrict)
  admin User? @relation("AdminPengajuanKoreksi", fields: [diprosesOleh], references: [id], onDelete: Restrict)

  @@index([guruId])
  @@index([status])
  @@map("pengajuan_koreksi")
}

enum StatusHasilPenilaian {
  belum_dinilai
  dinilai
  tidak_ikut

  @@map("status_hasil_penilaian")
}

// M4 Penilaian kelas: entitas tugas/penilaian per kelas dengan skala fleksibel
model Penilaian {
  id              Int               @id @default(autoincrement())
  kelasId         Int               @map("kelas_id")
  nama            String            @map("nama")
  tanggal         DateString        @map("tanggal")
  nilaiMaksimum   Decimal           @default("100") @map("nilai_maksimum")
  draf            Boolean           @default(true) @map("draf")
  diterbitkanPada TimestamptzString? @map("diterbitkan_pada")
  dibuatOleh      Int               @map("dibuat_oleh")
  createdAt       TimestamptzString @default(now()) @map("created_at")
  updatedAt       TimestamptzString @default(now()) @map("updated_at")

  kelas Kelas            @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  guru  User             @relation("GuruPenilaian", fields: [dibuatOleh], references: [id], onDelete: Restrict)
  hasil HasilPenilaian[]

  @@index([kelasId])
  @@index([dibuatOleh])
  @@index([tanggal])
  @@check(expression: "nilai_maksimum > 0", name: "penilaian_maksimum_positif")
  @@map("penilaian")
}

// M4 Hasil penilaian per siswa
model HasilPenilaian {
  id            Int                  @id @default(autoincrement())
  penilaianId   Int                  @map("penilaian_id")
  pendaftaranId Int                  @map("pendaftaran_id")
  statusHasil   StatusHasilPenilaian @default(belum_dinilai) @map("status_hasil")
  nilai         Decimal?             @map("nilai")
  catatan       String?              @map("catatan")
  createdAt     TimestamptzString    @default(now()) @map("created_at")
  updatedAt     TimestamptzString    @default(now()) @map("updated_at")

  penilaian   Penilaian   @relation(fields: [penilaianId], references: [id], onDelete: Cascade)
  pendaftaran Pendaftaran @relation(fields: [pendaftaranId], references: [id], onDelete: Cascade)

  @@unique([penilaianId, pendaftaranId])
  @@index([pendaftaranId])
  @@check(expression: "nilai IS NULL OR nilai >= 0", name: "hasil_penilaian_non_negatif")
  @@map("hasil_penilaian")
}

// M5 Laporan perkembangan murid (pemisahan catatan internal dan laporan publik)
model LaporanPerkembangan {
  id              Int                @id @default(autoincrement())
  pendaftaranId   Int                @map("pendaftaran_id")
  dicatatOleh     Int                @map("dicatat_oleh")
  tanggal         DateString
  judul           String             @default("Laporan Perkembangan")
  catatanInternal String?            @map("catatan_internal")
  laporanOrtu     String?            @map("laporan_ortu")
  draf            Boolean            @default(true)
  diterbitkanPada TimestamptzString? @map("diterbitkan_pada")
  createdAt       TimestamptzString  @default(now()) @map("created_at")
  updatedAt       TimestamptzString  @default(now()) @map("updated_at")

  pendaftaran Pendaftaran @relation(fields: [pendaftaranId], references: [id], onDelete: Cascade)
  guru        User        @relation("GuruLaporanPerkembangan", fields: [dicatatOleh], references: [id], onDelete: Restrict)

  @@index([pendaftaranId])
  @@index([dicatatOleh])
  @@index([tanggal])
  @@map("laporan_perkembangan")
}

enum StatusUnggahan {
  aktif
  diarsipkan
  ditarik_admin
  dihapus_guru

  @@map("status_unggahan")
}

// M6 & M7 Status pembelajaran: pembaruan teks (M6) dan dokumentasi foto hingga 5 (M7)
model StatusPembelajaran {
  id              Int               @id @default(autoincrement())
  kelasId         Int               @map("kelas_id")
  dibuatOleh      Int               @map("dibuat_oleh")
  kontenTeks      String            @map("konten_teks")
  mediaUrls       String?           @map("media_urls")
  status          StatusUnggahan    @default(aktif)
  diterbitkanPada TimestamptzString @default(now()) @map("diterbitkan_pada")
  kadaluarsaPada  TimestamptzString @map("kadaluarsa_pada")
  createdAt       TimestamptzString @default(now()) @map("created_at")
  updatedAt       TimestamptzString @default(now()) @map("updated_at")

  kelas       Kelas                        @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  guru        User                         @relation("GuruStatusPembelajaran", fields: [dibuatOleh], references: [id], onDelete: Restrict)
  penerima    StatusPembelajaranPenerima[]
  laporanFoto LaporanFotoStatus[]

  @@index([kelasId])
  @@index([dibuatOleh])
  @@index([status])
  @@index([diterbitkanPada])
  @@map("status_pembelajaran")
}

// Penerima dibekukan saat unggahan diterbitkan
model StatusPembelajaranPenerima {
  id            Int               @id @default(autoincrement())
  statusId      Int               @map("status_id")
  pendaftaranId Int               @map("pendaftaran_id")
  anakId        Int               @map("anak_id")
  createdAt     TimestamptzString @default(now()) @map("created_at")

  statusPembelajaran StatusPembelajaran @relation(fields: [statusId], references: [id], onDelete: Cascade)
  pendaftaran        Pendaftaran        @relation(fields: [pendaftaranId], references: [id], onDelete: Cascade)
  anak               Anak               @relation(fields: [anakId], references: [id], onDelete: Cascade)

  @@unique([statusId, pendaftaranId])
  @@index([pendaftaranId])
  @@index([anakId])
  @@map("status_pembelajaran_penerima")
}

// M7 Laporan orang tua terhadap foto privat
model LaporanFotoStatus {
  id        Int               @id @default(autoincrement())
  statusId  Int               @map("status_id")
  pelaporId Int               @map("pelapor_id")
  alasan    String
  catatan   String?
  createdAt TimestamptzString @default(now()) @map("created_at")

  statusPembelajaran StatusPembelajaran @relation(fields: [statusId], references: [id], onDelete: Cascade)
  pelapor            User               @relation("PelaporFotoStatus", fields: [pelaporId], references: [id], onDelete: Restrict)

  @@index([statusId])
  @@index([pelaporId])
  @@map("laporan_foto_status")
}
